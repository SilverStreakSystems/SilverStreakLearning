{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssls.local/schemas/product-definition-assurance/wave0-snapshot.json",
  "title": "Wave 0 authority and implementation snapshot",
  "description": "Shape of data/product-definition-assurance/wave0-declaration.json and of the generated projection data/product-definition-assurance/generated/wave0-snapshot.json. The declaration is hand-maintained and controlling. The projection is generated and never controlling.",
  "type": "object",
  "required": [
    "snapshot_id",
    "snapshot_version",
    "controlling_decision",
    "authority_class",
    "boundary",
    "state_axes",
    "preserved_program_state",
    "declared_inputs",
    "artifact_map",
    "reconciliation",
    "disposition_packet",
    "gated_future"
  ],
  "additionalProperties": true,
  "properties": {
    "snapshot_id": { "type": "string", "pattern": "^PDA-WAVE0$" },
    "snapshot_version": { "type": "string" },
    "controlling_decision": { "type": "string", "pattern": "^DEC-[0-9]{3}$" },
    "authority_class": { "type": "string", "enum": ["candidate"] },
    "boundary": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "state_axes": {
      "type": "object",
      "required": [
        "truth",
        "authority",
        "lifecycle",
        "implementation",
        "validation",
        "release",
        "claim_eligibility"
      ],
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2
      }
    },
    "preserved_program_state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject", "state", "source"],
        "properties": {
          "subject": { "type": "string" },
          "state": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "declared_inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "artifact_map": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact",
          "existing_canonical_sources",
          "current_evidence",
          "present",
          "missing_fields",
          "conflicts",
          "recommended_extension",
          "states"
        ],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^PDA-A[0-9]{2}$" },
          "artifact": { "type": "string" },
          "existing_canonical_sources": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "current_evidence": { "type": "array", "items": { "type": "string" } },
          "present": { "type": "string" },
          "missing_fields": { "type": "array", "items": { "type": "string" } },
          "conflicts": { "type": "array", "items": { "type": "string" } },
          "recommended_extension": { "type": "string" },
          "states": {
            "type": "object",
            "required": [
              "truth",
              "authority",
              "lifecycle",
              "implementation",
              "validation",
              "release",
              "claim_eligibility"
            ],
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "reconciliation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entry_id", "subject", "observation", "resolution_rule", "sources"],
        "properties": {
          "entry_id": { "type": "string", "pattern": "^PDA-R[0-9]{2}$" },
          "subject": { "type": "string" },
          "observation": { "type": "string" },
          "resolution_rule": { "type": "string" },
          "owner_decision_required": { "type": "boolean" },
          "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "disposition_packet": {
      "type": "object",
      "required": ["disposition_recorded", "options"],
      "properties": {
        "disposition_recorded": { "type": "null" },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["option_id", "label", "meaning", "consequences", "smallest_next_action"],
            "properties": {
              "option_id": { "type": "string", "enum": ["PDA-D1", "PDA-D2", "PDA-D3"] },
              "label": {
                "type": "string",
                "enum": ["ACCEPT BASELINE", "REVISE BASELINE", "HOLD"]
              },
              "meaning": { "type": "string" },
              "consequences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "smallest_next_action": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gated_future": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject", "state"],
        "properties": {
          "subject": { "type": "string" },
          "state": { "type": "string", "enum": ["not-authorized", "deferred-not-run"] }
        },
        "additionalProperties": false
      }
    }
  }
}
