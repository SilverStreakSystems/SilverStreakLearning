{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silverstreaklearning.systems/schema/touch-target-rule/1.0.0",
  "title": "SSLS Touch Target Acceptance Rule Schema",
  "description": "WP-007 Cycle 7 canonical schema for the internal SSLS touch-target acceptance rule and its future verification protocol. Defining a rule and a protocol is not running an audit. No field in this schema may express conformance, validation, release, or a passing interface state.",
  "schema_version": "1.0.0",
  "work_package": "WP-007",
  "authority_note": "The rule is internal and owner-authorized by a recorded decision. Cited external specifications are inputs only; nothing here asserts WCAG, ADA, Section 508, legal, or independent conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "rule_version",
    "title",
    "authority",
    "lifecycle_state",
    "controlling_decision",
    "default_target",
    "measurable_floor",
    "exceptions",
    "compact_target_departure",
    "below_floor_target",
    "precedence",
    "verification",
    "sources",
    "non_claims",
    "history"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "rule_id": { "const": "TTR-001" },
    "rule_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_class", "authority_statement", "scope", "exclusions"],
      "properties": {
        "authority_class": { "const": "INTERNAL-SSLS-ACCEPTANCE-RULE" },
        "authority_statement": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "lifecycle_state": { "enum": ["DEFINED-NOT-VERIFIED"] },
    "controlling_decision": { "type": "string", "pattern": "^DEC-\\d{3}$" },
    "default_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "width_css_px", "height_css_px", "applies_to", "statement"],
      "properties": {
        "obligation": { "const": "SHOULD" },
        "width_css_px": { "const": 44 },
        "height_css_px": { "const": 44 },
        "applies_to": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "measurable_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "width_css_px", "height_css_px", "applies_to", "statement"],
      "properties": {
        "obligation": { "const": "MUST" },
        "width_css_px": { "const": 24 },
        "height_css_px": { "const": 24 },
        "applies_to": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "exceptions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exception" }
    },
    "compact_target_departure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_bound_css_px",
        "upper_bound_css_px",
        "acceptance_criteria",
        "may_authorize_below_floor",
        "statement"
      ],
      "properties": {
        "lower_bound_css_px": { "const": 24 },
        "upper_bound_css_px": { "const": 43 },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "may_authorize_below_floor": { "const": false },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "below_floor_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_css_px", "only_route", "compact_rationale_accepted", "statement"],
      "properties": {
        "threshold_css_px": { "const": 24 },
        "only_route": { "const": "DOCUMENTED-EXCEPTION" },
        "compact_rationale_accepted": { "const": false },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "precedence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "execution_state",
        "viewports_css_px",
        "classifications",
        "record_fields",
        "spacing_check",
        "manual_review_required_for",
        "boundary"
      ],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "execution_state": { "const": "NOT-RUN" },
        "viewports_css_px": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "enum": [320, 768, 1366] },
          "uniqueItems": true
        },
        "classifications": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PASS-44-DEFAULT",
              "PASS-24-FLOOR",
              "PASS-EXCEPTION",
              "FAIL",
              "NOT-APPLICABLE"
            ]
          }
        },
        "record_fields": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/field" } },
        "spacing_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["circle_diameter_css_px", "centering", "pass_condition", "statement"],
          "properties": {
            "circle_diameter_css_px": { "const": 24 },
            "centering": { "type": "string", "minLength": 1 },
            "pass_condition": { "type": "string", "minLength": 1 },
            "statement": { "type": "string", "minLength": 1 }
          }
        },
        "manual_review_required_for": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exceptionType" }
        },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "sources": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/source" } },
    "non_claims": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/historyEntry" } }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "exceptionType": {
      "enum": ["SPACING", "EQUIVALENT-CONTROL", "INLINE", "USER-AGENT-CONTROL", "ESSENTIAL"]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_type", "label", "condition", "determination", "required_record"],
      "properties": {
        "exception_type": { "$ref": "#/$defs/exceptionType" },
        "label": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "determination": { "enum": ["MECHANICAL", "MANUAL-REVIEW"] },
        "required_record": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "requirement", "description"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "requirement": { "enum": ["REQUIRED", "CONDITIONAL"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "url", "role"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^TTS-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://www\\.w3\\.org/" },
        "role": { "const": "INPUT-ONLY" }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version", "recorded_on", "decision", "change", "boundary"],
      "properties": {
        "rule_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "recorded_on": { "$ref": "#/$defs/isoDate" },
        "decision": { "type": "string", "pattern": "^DEC-\\d{3}$" },
        "change": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
