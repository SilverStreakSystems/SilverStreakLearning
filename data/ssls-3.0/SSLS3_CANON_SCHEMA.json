{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://silverstreaklearning.com/schema/ssls-3.0-canon-1.0.0.json",
  "title": "SSLS 3.0 canon record",
  "description": "Registers the SSLS 3.0 foundation documents held in this repository and the open owner decisions they raise. Registration is an index, not an approval: no document gains authority by appearing here, and no decision is closed by being listed. Authority comes only from a recorded owner decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canon_id",
    "canon_title",
    "recorded_at",
    "recorded_by",
    "authority_class",
    "non_authority_statement",
    "clean_slate_statement",
    "document_count",
    "documents",
    "open_decision_count",
    "open_decisions",
    "unresolved_items",
    "non_effects"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "canon_id": { "type": "string", "pattern": "^SSLS3-CANON-\\d{3}$" },
    "canon_title": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorded_by": { "type": "string", "minLength": 1 },
    "authority_class": {
      "description": "The authority this record carries over the documents it indexes. Registration never confers authority, so the only admissible value states that.",
      "enum": ["INDEX ONLY — NON-CONTROLLING"]
    },
    "non_authority_statement": { "type": "string", "minLength": 1 },
    "clean_slate_statement": {
      "description": "Restates that SSLS 3.0 does not inherit from the SSLS 2.0 material in this repository. Co-location in one repository is not inheritance.",
      "type": "string",
      "minLength": 1
    },
    "document_count": { "type": "integer", "minimum": 0 },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/definitions/document" }
    },
    "open_decision_count": { "type": "integer", "minimum": 0 },
    "open_decisions": {
      "type": "array",
      "items": { "$ref": "#/definitions/openDecision" }
    },
    "unresolved_items": {
      "description": "Discrepancies carried forward rather than silently corrected.",
      "type": "array",
      "items": { "$ref": "#/definitions/unresolvedItem" }
    },
    "non_effects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "file_name",
        "title",
        "document_class",
        "version",
        "status",
        "canonical_status",
        "authority_level",
        "review_class",
        "controlled_concept",
        "provenance",
        "authorizing_decision",
        "open_decision_ids"
      ],
      "properties": {
        "document_id": { "type": "string", "pattern": "^SSLS3-DOC-\\d{2}$" },
        "file_name": { "type": "string", "pattern": "^\\d{2}-SSLS_3\\.0_[A-Z_0-9]+\\.md$" },
        "title": { "type": "string", "minLength": 1 },
        "document_class": {
          "enum": ["navigational", "governance", "status", "product", "register", "structure"]
        },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-draft)?$" },
        "status": { "type": "string", "minLength": 1 },
        "canonical_status": {
          "description": "Lifecycle status from file 03. CANONICAL requires an authorizing owner decision; the loader refuses the combination without one.",
          "enum": ["DRAFT", "CANDIDATE", "CANONICAL", "SUPERSEDED", "ARCHIVED", "WITHDRAWN"]
        },
        "authority_level": { "type": "string", "minLength": 1 },
        "review_class": {
          "description": "Stated honestly, including when it is AI-assisted self-review. Absent means the document does not state one, which is itself a defect.",
          "type": ["string", "null"]
        },
        "controlled_concept": { "type": "string", "minLength": 1 },
        "provenance": {
          "description": "transcribed: reproduced from an observed source item. reconstructed: composed from content cited elsewhere because no source item existed.",
          "enum": ["transcribed", "reconstructed"]
        },
        "provenance_note": { "type": "string" },
        "source_item_name": { "type": ["string", "null"] },
        "authorizing_decision": {
          "description": "Identifier of the recorded owner decision that accepted this document. Null while none exists.",
          "type": ["string", "null"]
        },
        "open_decision_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OD-\\d{2}-\\d+[A-Z]?$" }
        }
      }
    },
    "openDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "source_document_id", "priority", "question", "state"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^OD-\\d{2}-\\d+[A-Z]?$" },
        "source_document_id": { "type": "string", "pattern": "^SSLS3-DOC-\\d{2}$" },
        "priority": {
          "description": "1 blocks everything downstream. unranked means the foundation package states no priority for it.",
          "enum": ["1", "2", "3", "unranked"]
        },
        "question": { "type": "string", "minLength": 1 },
        "state": {
          "description": "Only the owner moves a decision out of open. No other value is admissible in this record.",
          "enum": ["open"]
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "summary", "positions", "routed_to"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^U3-\\d{3}$" },
        "summary": { "type": "string", "minLength": 1 },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "routed_to": { "type": "string", "pattern": "^OD-\\d{2}-\\d+[A-Z]?$" }
      }
    }
  }
}
