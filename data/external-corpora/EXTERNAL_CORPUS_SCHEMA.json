{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://silverstreaklearning.com/schema/external-corpus-observation-1.0.0.json",
  "title": "External corpus observation",
  "description": "Records that an external corpus was observed at a point in time. An observation record indexes items; it never copies their content, never promotes them, and never confers authority. It is a statement about what was seen, not about what is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_title",
    "location_class",
    "observed_at",
    "observed_by",
    "observation_method",
    "authority_class",
    "non_authority_statement",
    "item_count",
    "items",
    "declared_but_absent",
    "non_effects"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "corpus_id": { "type": "string", "pattern": "^XC-\\d{3}$" },
    "corpus_title": { "type": "string", "minLength": 1 },
    "location_class": {
      "description": "The class of location the corpus was observed in. A location is a place a file sits; it confers no authority.",
      "enum": ["connected-storage", "owner-supplied-upload", "external-service", "unknown"]
    },
    "location_reference": {
      "type": "string",
      "description": "Opaque provider identifier for the observed container. Never a credential."
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "observed_by": { "type": "string", "minLength": 1 },
    "observation_method": { "type": "string", "minLength": 1 },
    "observation_independence": { "type": "string", "minLength": 1 },
    "authority_class": {
      "description": "Fixed. An observation record may only ever be non-controlling external reference.",
      "const": "HISTORICAL_REFERENCE — NON-CONTROLLING"
    },
    "non_authority_statement": { "type": "string", "minLength": 1 },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    },
    "declared_but_absent": {
      "description": "Artifacts the observed corpus cites as controlling but which were not present at observation time.",
      "type": "array",
      "items": { "$ref": "#/definitions/absentItem" }
    },
    "non_effects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_name",
        "item_class",
        "provider_file_id",
        "media_type",
        "observed_at",
        "location_class"
      ],
      "properties": {
        "item_name": { "type": "string", "minLength": 1 },
        "item_class": {
          "enum": ["foundation-document", "workbook", "spreadsheet", "probe", "other"]
        },
        "provider_file_id": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "byte_size": { "type": ["integer", "null"], "minimum": 0 },
        "modified_at": { "type": ["string", "null"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "location_class": {
          "enum": ["connected-storage", "owner-supplied-upload", "external-service", "unknown"]
        },
        "declared_document_id": { "type": ["string", "null"] },
        "declared_status": {
          "description": "The status the item declares about itself. Self-declaration is not authority, and no accepted, canonical, approved, promoted, adopted, or implemented value may be recorded here.",
          "type": ["string", "null"]
        },
        "declared_role": { "type": ["string", "null"] },
        "read_state": {
          "description": "Whether this observation read the item's content or only its listing metadata.",
          "enum": ["content-read", "metadata-only"]
        }
      }
    },
    "absentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_document_id", "declared_title", "cited_by", "presence"],
      "properties": {
        "declared_document_id": { "type": "string", "minLength": 1 },
        "declared_title": { "type": "string", "minLength": 1 },
        "cited_by": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "presence": { "const": "ABSENT-AT-OBSERVATION" },
        "note": { "type": "string" }
      }
    }
  }
}
